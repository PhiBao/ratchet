# --- Ratchet configuration. Copy to .env and fill in. ---
# Never commit .env. No exchange API keys are used — Agent OS authenticates
# via OAuth (see `ratchet auth login`).

# LLM endpoint for Reflector/Curator (OpenAI-compatible chat completions).
# Works with a local gateway, OpenAI, or any compatible provider.
LLM_BASE_URL=http://127.0.0.1:8318/v1
LLM_API_KEY=dummy
LLM_MODEL=gpt-5.6-sol

# Binance Agent OS MCP (public client, PKCE, no DCR — uses CIMD).
# client_id must be an https:// URL hosting your client metadata JSON
# (publish once your repo is public; until then auth login prints guidance).
RATCHET_CLIENT_ID=https://raw.githubusercontent.com/YOURUSER/ratchet/main/cimd.json
RATCHET_REDIRECT_URI=http://127.0.0.1:8099/callback

# Safety mandate (also enforced in code defaults — .env only tightens).
RATCHET_MAX_PER_TRADE_USD=50
RATCHET_MAX_DAILY_LOSS_USD=100
RATCHET_CONFIRM_ABOVE_USD=20
RATCHET_KILL_SWITCH=data/HALT
